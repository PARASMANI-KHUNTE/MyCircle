{
  "name": "MyCircleMobileBare",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:win": "powershell -ExecutionPolicy Bypass -File scripts/run-android-shortpath.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "generate:icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "start": "react-native start --config metro.config.js",
    "start:8081": "react-native start --config metro.config.js --port 8081",
    "test": "jest",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/bundles/index.android.bundle --assets-dest dist/bundles/android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output dist/bundles/main.jsbundle --assets-dest dist/bundles/ios",
    "codepush:android:staging": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare -d Staging",
    "codepush:android:production": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare -d Production",
    "codepush:ios:staging": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare-iOS -d Staging",
    "codepush:ios:production": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare-iOS -d Production"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.17.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "27.1.1",
    "@react-native-firebase/firestore": "27.1.1",
    "@react-native-firebase/messaging": "27.1.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native/gradle-plugin": "0.88.1",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/stack": "^7.12.2",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.108.3",
    "@types/react-native": "~0.69.1",
    "axios": "^1.21.1",
    "lucide-react-native": "^1.78.0",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-android-location-enabler": "^3.0.1",
    "react-native-code-push": "^9.0.1",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-keychain": "^11.0.0",
    "react-native-reanimated": "^4.8.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.16.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.14.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.14",
    "@react-native-community/cli": "21.0.0",
    "@react-native-community/cli-platform-android": "21.0.0",
    "@react-native-community/cli-platform-ios": "21.0.0",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/eslint-config": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/metro-config": "^0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "metro": "^0.88.0",
    "patch-package": "^8.0.1",
    "prettier": "3.10.1",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
