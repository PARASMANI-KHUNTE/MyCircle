{
  "name": "MyCircleMobileBare",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:win": "powershell -ExecutionPolicy Bypass -File scripts/run-android-shortpath.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "start": "react-native start --config metro.config.js",
    "start:8081": "react-native start --config metro.config.js --port 8081",
    "test": "jest",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "codepush:android:staging": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare -d Staging",
    "codepush:android:production": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare -d Production",
    "codepush:ios:staging": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare-iOS -d Staging",
    "codepush:ios:production": "appcenter codepush release-react -a YourOrg/MyCircleMobileBare-iOS -d Production"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native/gradle-plugin": "^0.88.0",
    "@react-native/new-app-screen": "0.88.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/react-native": "~0.69.1",
    "axios": "^1.20.0",
    "expo": "^58.0.19",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-android-location-enabler": "^3.0.1",
    "react-native-code-push": "^9.0.1",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/runtime": "^8.0.8",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.1.2",
    "@react-native-community/cli-platform-ios": "^20.1.2",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/eslint-config": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "metro": "^0.87.2",
    "patch-package": "^8.0.1",
    "prettier": "3.9.10",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
